# Bifire CRM — ortam değişkenleri. Gerçek değerler .env içinde (git'e girmez).
# Gizli anahtar üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# --- Uygulama ---
# production: https://crm.bifiresomine.com (https zorunlu)
APP_URL=http://localhost:3720
# development | staging | production
APP_ENV=development

# --- Veritabanı (CRM'e ait ayrı PostgreSQL; site veritabanı DEĞİL) ---
# Uygulama: pooler bağlantısı. Migration + yedek: DIRECT_URL (pooler'sız host).
DATABASE_URL=postgresql://USER:PASS@HOST-pooler/DB?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASS@HOST/DB?sslmode=verify-full
DB_POOL_MAX=10

# --- Gizli anahtarlar (her biri en az 32 karakter, ortam başına ayrı) ---
SESSION_SECRET=
FILE_URL_SECRET=
# MFA sırları + entegrasyon kimlik bilgileri (AES-256-GCM). Değişirse eski şifreli veriler okunamaz.
DATA_ENCRYPTION_KEY=

# --- Dosya deposu (production: s3, özel bucket) ---
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/private
MAX_UPLOAD_MB=20
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Virüs taraması (opsiyonel; tanımlı değilse dosyalar "taranmadı" işaretlenir) ---
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- İç bildirim e-postası (opsiyonel; yoksa yalnız uygulama içi bildirim) ---
# ör. smtps://user:pass@smtp.ornek.com:465
SMTP_URL=
SMTP_FROM=

# --- Faz 2: web sitesi → CRM (HMAC imzalı istek) ---
WEBSITE_HMAC_SECRET=
